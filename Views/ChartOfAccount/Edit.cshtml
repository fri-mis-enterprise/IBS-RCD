<link rel="stylesheet" href="~/css/form-style.css" asp-append-version="true" />
@model Accounting_System.Models.ChartOfAccount

@{
    ViewData["Title"] = "EDIT CHART OF ACCOUNT";

}
<div class="loader-container">
    <div class="loader"></div>
    <div class="loader-text">Loading...</div>
</div>
<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">@ViewData["Title"]</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group form-check mb-3">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsMain" /> Main Account
                </label>
            </div>
            <div class="form-group mb-3">
                <label asp-for="AccountNumber" class="control-label"></label>
                <input asp-for="AccountNumber" class="form-control border-0 shadow" />
                <span asp-validation-for="AccountNumber" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="AccountName" class="control-label"></label>
                <input asp-for="AccountName" class="form-control border-0 shadow" />
                <span asp-validation-for="AccountName" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="AccountType" class="control-label"></label>
                <input asp-for="AccountType" class="form-control border-0 shadow" />
                <span asp-validation-for="AccountType" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="NormalBalance" class="control-label"></label>
                <input asp-for="NormalBalance" class="form-control border-0 shadow" />
                <span asp-validation-for="NormalBalance" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Level" class="control-label"></label>
                <input asp-for="Level" class="form-control border-0 shadow" />
                <span asp-validation-for="Level" class="text-danger"></span>
            </div>
            <input type="hidden" asp-for="AccountId" />
            <input asp-for="CreatedBy" type="hidden" class="form-control border-0 shadow" />
            <input asp-for="CreatedDate" type="hidden" class="form-control border-0 shadow" />
                        <div class="form-check mb-3"><input asp-for="IsHidden" class="form-check-input" /><label asp-for="IsHidden" class="form-check-label"></label></div>
            <div class="mb-3"><label asp-for="FinancialStatementType"></label><select asp-for="FinancialStatementType" class="form-select border-0 shadow"><option value="">Select statement type</option><option value="BalanceSheet">Balance Sheet</option><option value="PnL">Profit and Loss</option></select><span asp-validation-for="FinancialStatementType" class="text-danger"></span></div>
            <div class="row pt-2">
                <div class="col-6 col-md-3">
                    <button type="submit" class="btn btn-primary form-control">Save</button>
                </div>
                <div class="col-6 col-md-3">
                    <a asp-controller="ChartOfAccount" asp-action="Index" class="btn btn-outline-primary border  form-control ">Back to List</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
