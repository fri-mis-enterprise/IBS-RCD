<link rel="stylesheet" href="~/css/form-style.css" asp-append-version="true" />
@model Accounting_System.Models.ChartOfAccount

@{
    ViewData["Title"] = "CREATE CHART OF ACCOUNT";

}
<div class="loader-container">
    <div class="loader"></div>
    <div class="loader-text">Loading...</div>
</div>
<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">@ViewData["Title"]</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <form asp-action="Create" method="post" id="account-form" data-children-url="@Url.Action("GetChartOfAccount", "ChartOfAccount")" data-number-url="@Url.Action("GenerateNumber", "ChartOfAccount")">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="form-group mb-3">
                <label class="control-label">Main<span class="required">*</span></label>
                <select id="mainLevel" asp-items="@Model.Main" class="form-select js-select2" style=" width: 100%" required>
                    <option></option>
                </select>
            </div>
            <div class="form-group mb-3">
                <label class="control-label">Second Level<span class="required">*</span></label>
                <select id="secondLevel" class="form-select js-select2" style=" width: 100%" required>
                    <option></option>
                </select>
            </div>
            <div class="form-group mb-3">
                <label class="control-label">Third Level<span class="required">*</span></label>
                <select id="thirdLevel" name="thirdLevel" class="form-select js-select2" style=" width: 100%" required>
                    <option></option>
                </select>
            </div>

            <div class="form-group mb-3" id="fourthLevelDiv" style="display:none">
                <label class="control-label">Fourth Level<span class="required">*</span></label>
                <select disabled id="fourthLevel" name="fourthLevel" class="form-select js-select2" style=" width: 100%" required>
                    <option></option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label>Account Number</label>
                <input asp-for="AccountNumber" class="form-control border-0 shadow" readonly />
            </div>

            <div class="form-floating my-3">
                <input asp-for="AccountName" id="floatingInput" class="form-control border-0 shadow" placeholder="Account Name" />
                <label for="floatingInput" class="control-label">Account Name<span class="required">*</span></label>
                <span asp-validation-for="AccountName" class="text-danger"></span>
            </div>
                        <div class="form-check mb-3"><input asp-for="IsHidden" class="form-check-input" /><label asp-for="IsHidden" class="form-check-label"></label></div>
            <div class="mb-3"><label asp-for="FinancialStatementType"></label><select asp-for="FinancialStatementType" class="form-select border-0 shadow"><option value="">Select statement type</option><option value="BalanceSheet">Balance Sheet</option><option value="PnL">Profit and Loss</option></select><span asp-validation-for="FinancialStatementType" class="text-danger"></span></div>
            <div class="row pt-2">
                <div class="col-6 col-md-3">
                    <button type="submit" class="btn btn-primary form-control">Create</button>
                </div>
                <div class="col-6 col-md-3">
                    <a asp-controller="ChartOfAccount" asp-action="Index" class="btn btn-outline-primary border  form-control ">Back to List</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/chart-account-form.js" asp-append-version="true"></script>
}

