@model IEnumerable<ImportExportLog>

@{
    ViewData["Title"] = "Import Export Logs";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/indexLayout.css" asp-append-version="true" />

<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">IMPORT EXPORT LOGS</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4 table-responsive">
        <div class="row pb-3">
            <div class="col-6">
            </div>
            <div class="col-6 text-end">
                <p>
                    <a asp-action="GenerateLogReport" asp-controller="ImportExportLogs" type="button" class="btn btn-primary">Generate import/export log Report</a>
                </p>
            </div>
        </div>

        <table class="table table-bordered table-hover" id="dataTable">
            <thead class="table-secondary">
            <tr class="text-nowrap">
                <th>
                    @Html.DisplayNameFor(model => model.Id)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.DocumentRecordId)
                </th>
                <th>
                    Series Number
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.TableName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ColumnName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.OriginalValue)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.AdjustedValue)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.TimeStamp)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.UploadedBy)
                </th>
                <th>
                    SYSTEM
                </th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr class="align-text-bottom" data-database="@item.DatabaseName" data-document="@item.DocumentRecordId" data-number="@item.DocumentNo" data-stamp="@item.TimeStamp.Ticks">
                    <td class="document-id">
                        @Html.DisplayFor(model => item.Id)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.DocumentRecordId)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.DocumentNo)
                    </td>
                    <td class="table-name">
                        @Html.DisplayFor(model => item.TableName)
                    </td>
                    <td class="column-name">
                        @Html.DisplayFor(model => item.ColumnName)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.OriginalValue)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.AdjustedValue)
                    </td>
                    <td>
                        @item.TimeStamp.ToString("MM/dd/yyyy hh:mm:ss.ffffff")
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.UploadedBy)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.DatabaseName)
                    </td>
                    <td>
                        <a class="btn btn-primary form-control buttons action">Action</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
@section Scripts {
    <script>
        document.querySelectorAll('.action').forEach(function (element) {
            element.addEventListener('click', function () {
                const tr = this.closest('tr'); // Get the closest <tr>
                const recordId = tr.querySelector('.document-id').textContent.trim(); // Retrieve the DocumentRecordId
                const tableName = tr.querySelector('.table-name').textContent.trim();
                const columnName = tr.querySelector('.column-name').textContent.trim();

                const prefix = columnName.startsWith('CheckVoucherTradePayments.') ? 'CheckVoucherTradePayments.' :
                    columnName.startsWith('MultipleCheckVoucherPayments.') ? 'MultipleCheckVoucherPayments.' : null;
                const paymentGroup = ['IBS-RCD', 'AAS'].includes(tr.dataset.database) && prefix !== null;
                let reviewText = tr.dataset.database + ' — ' + tableName + ' / ' + columnName + ': ' +
                    tr.cells[5].textContent.trim() + ' → ' + tr.cells[6].textContent.trim() +
                    '. Modify applies this value; Keep preserves the current value.';
                if (paymentGroup) {
                    const related = [...document.querySelectorAll('tr[data-stamp]')].filter(row =>
                        row.dataset.database === tr.dataset.database && row.dataset.document === tr.dataset.document &&
                        row.dataset.number === tr.dataset.number && row.dataset.stamp === tr.dataset.stamp &&
                        row.querySelector('.table-name').textContent.trim() === tableName &&
                        row.querySelector('.column-name').textContent.trim().startsWith(prefix));
                    reviewText = tr.dataset.database + ' — These related payment fields are reviewed together: ' + related.map(row =>
                        row.cells[4].textContent.trim() + ': ' + row.cells[5].textContent.trim() + ' → ' + row.cells[6].textContent.trim()).join('; ');
                }

                Swal.fire({
                    title: 'Choose an action',
                    text: reviewText,
                    icon: 'question',
                    showCancelButton: true,
                    showDenyButton: true,
                    confirmButtonText: paymentGroup ? 'Modify payment group' : 'Modify',
                    denyButtonText: paymentGroup ? 'Keep payment group' : 'Keep',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        
                        window.location.href = '@Url.Action("ImportAction", "ImportExportLogs")?' + new URLSearchParams({ id: recordId, procedure: 'Modify' });
                    } else if (result.isDenied) {
                        
                        window.location.href = '@Url.Action("ImportAction", "ImportExportLogs")?' + new URLSearchParams({ id: recordId, procedure: 'Keep' });
                    }
                    // No action needed if "Cancel" is clicked.
                });
            });
        });
    </script>
}
