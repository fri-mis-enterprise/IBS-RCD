@using Accounting_System.Utility
@model Accounting_System.Models.MasterFile.Supplier

@{
    ViewData["Title"] = "Supplier - Edit";
}

<link rel="stylesheet" href="~/css/form-style.css" asp-append-version="true">

<div class="loader-container">
    <div class="loader"></div>
    <div class="loader-text">Loading...</div>
</div>
<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">@ViewData["Title"]</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input asp-for="SupplierId" type="hidden" />
            <input asp-for="SupplierCode" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <fieldset class="form-group mb-3">
                <legend>Select Category</legend>

                <div class="form-check form-check-inline mb-3">
                    <input asp-for="Category" class="form-check-input" type="radio" id="inlineRadio1" value="Trade" aria-labelledby="labelInlineRadio1">
                    <label class="form-check-label" for="inlineRadio1" id="labelInlineRadio1">Trade</label>
                </div>

                <div class="form-check form-check-inline">
                    <input asp-for="Category" class="form-check-input" type="radio" id="inlineRadio2" value="Non-Trade" aria-labelledby="labelInlineRadio2">
                    <label class="form-check-label" for="inlineRadio2" id="labelInlineRadio2">Non-Trade</label>
                </div>

                <div class="form-check form-check-inline">
                    <input asp-for="Category" class="form-check-input" type="radio" id="inlineRadio3" value="Commissionee" aria-labelledby="labelInlineRadio3">
                    <label class="form-check-label" for="inlineRadio3" id="labelInlineRadio3">Commissionee</label>
                </div>

                <div class="form-check form-check-inline">
                    <input asp-for="Category" class="form-check-input" type="radio" id="inlineRadio4" value="Hauler" aria-labelledby="labelInlineRadio4">
                    <label class="form-check-label" for="inlineRadio4" id="labelInlineRadio4">Hauler</label>
                </div>

                <div class="form-check form-check-inline">
                    <input asp-for="Category" class="form-check-input" type="radio" id="inlineRadio5" value="Employee" aria-labelledby="labelInlineRadio5">
                    <label class="form-check-label" for="inlineRadio5" id="labelInlineRadio5">Employee</label>
                </div>

                <br />
                <span class="text-danger"></span>
            </fieldset>
            <div class="form-floating mb-3" id="tradeList" style="display: none;">
                <input asp-for="TradeName" class="form-control" placeholder="" />
                <label asp-for="TradeName" class="control-label">Trade Name<span class="required">*</span></label>
                <span asp-validation-for="TradeName" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="SupplierName" class="form-control" placeholder="" />
                <label asp-for="SupplierName" class="control-label">Name<span class="required">*</span></label>
                <span asp-validation-for="SupplierName" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="SupplierAddress" class="form-control" placeholder="" />
                <label asp-for="SupplierAddress" class="control-label">Address<span class="required">*</span></label>
                <span asp-validation-for="SupplierAddress" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="ZipCode" class="form-control" placeholder="" maxlength="4" />
                <label asp-for="ZipCode" class="control-label">Zip Code<span class="required">*</span></label>
                <span asp-validation-for="ZipCode" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="form-floating col-12 col-md-6 mb-3">
                    <input asp-for="SupplierTin" class="form-control formattedTinNumberInput" placeholder="" maxlength="17" />
                    <label asp-for="SupplierTin" class="control-label ms-2">Tin No<span class="required">*</span></label>
                    <span asp-validation-for="SupplierTin" class="text-danger"></span>
                </div>
                <div class="form-floating col-12 col-md-6 mb-3">
                    <input asp-for="Branch" class="form-control" placeholder="" />
                    <label asp-for="Branch" class="control-label ms-2">Branch</label>
                    <span asp-validation-for="Branch" class="text-danger"></span>
                </div>
            </div>
            <div class="form-floating mb-3" id="employeeList" style="display: none;">
                <input asp-for="EmployeeNumber" class="form-control" placeholder="" />
                <label asp-for="EmployeeNumber" class="control-label">Employee Number<span class="required">*</span></label>
                <span asp-validation-for="EmployeeNumber" class="text-danger"></span>
            </div>
            <div class="form-group mb-3" id="nonTradeList" style="display: none;">
                <label class="control-label">Default Expense</label>
                <select asp-for="DefaultExpenseNumber" asp-items="@Model.DefaultExpenses" class="form-select js-select2" style="width: 100%">
                    <option></option>
                </select>
                <span asp-validation-for="DefaultExpenseNumber" class="text-danger"></span>
            </div>
            <div class="form-group mb-3 col-12">
                <label asp-for="SupplierTerms" class="control-label"></label><span class="required">*</span>
                <select asp-for="SupplierTerms" class="form-select js-select2" style="width:100%"><option value=""></option><option value="COD">COD</option>
<option value="PREPAID">PREPAID</option>
<option value="7D">7D</option>
<option value="10D">10D</option>
<option value="15D">15D</option>
<option value="30D">30D</option>
<option value="45D">45D</option>
<option value="60D">60D</option>
<option value="90D">90D</option>
<option value="15PDC">15PDC</option>
<option value="30PDC">30PDC</option>
<option value="45PDC">45PDC</option>
<option value="60PDC">60PDC</option>
<option value="M15">M15</option>
<option value="M29">M29</option>
<option value="M30">M30</option></select>
                <span asp-validation-for="SupplierTerms" class="text-danger"></span>
            </div>
            <div class="form-group py-2 col-12">
                <label class="control-label">Vat Type<span class="required">*</span></label>
                <select asp-for="VatType" class="form-select js-select2 border-0 shadow" style="width:100%; max-height: 200px;">
                    <option value="" selected disabled>Select vat type</option>
                    <option value="@CS.VatType_Vatable">@CS.VatType_Vatable</option>
                    <option value="@CS.VatType_ZeroRated">@CS.VatType_ZeroRated</option>
                    <option value="@CS.VatType_Exempt">@CS.VatType_Exempt</option>
                </select>
                <span asp-validation-for="VatType" class="text-danger"></span>
            </div>
            <div class="form-group py-2 col-12">
                <label class="control-label">Tax Type<span class="required">*</span></label>
                <select asp-for="TaxType" class="form-select js-select2 border-0 shadow" style="width:100%; max-height: 200px;">
                    <option value="" selected disabled>Select tax type</option>
                    <option value="@CS.TaxType_WithTax">@CS.TaxType_WithTax</option>
                    <option value="@CS.TaxType_Exempt">@CS.TaxType_Exempt</option>
                </select>
                <span asp-validation-for="TaxType" class="text-danger"></span>
            </div>
            <div class="form-group mb-3" id="supplier-tax-rate" style="display: none;">
                <label class="control-label">Percent</label>
                <select asp-for="WithholdingTaxPercent" class="form-select js-select2 withHoldingTaxPercent" style="width: 100%">
                    <option value="" selected disabled>%</option>
                    <option value="0.5">.5%</option>
                    <option value="1">1%</option>
                    <option value="2">2%</option>
                    <option value="5">5%</option>
                    <option value="10">10%</option>
                </select>
                <span asp-validation-for="WithholdingTaxPercent" class="text-danger withHoldingTaxPercent"></span>
            </div>
            <div class="form-group mb-3" id="WithholdingTaxTitle" style="display: none;">
                <label class="control-label">Withholding Tax Title</label>
                <select asp-for="WithholdingTaxtitle" asp-items="@Model.WithholdingTaxList" class="form-select js-select2" style="width: 100%">
                    <option></option>
                </select>
                <span asp-validation-for="WithholdingTaxtitle" class="text-danger"></span>
            </div>
            <div id="exemptionFields" style="display:none;">
                <div class="form-floating mb-3">
                    <textarea asp-for="ReasonOfExemption" class="form-control" placeholder="Reason of exemption" style="height: 100px" required></textarea>
                    <label asp-for="ReasonOfExemption" class="control-label">Reason<span class="required">*</span></label>
                    <span asp-validation-for="ReasonOfExemption" class="text-danger"></span>
                </div>
                <fieldset class="mb-3">
                    <legend>Validity<span class="required">*</span></legend>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" asp-for="Validity" id="ValidityPermanent" value="Permanent" required>
                        <label class="form-check-label" for="ValidityPermanent">Permanent</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" asp-for="Validity" id="ValidityTemporary" value="Temporary">
                        <label class="form-check-label" for="ValidityTemporary">Temporary</label>
                    </div>
                    <span asp-validation-for="Validity" class="text-danger"></span>
                </fieldset>
                <div id="validityDateField" class="form-group mb-3">
                    <label asp-for="ValidityDate" class="control-label">Validity Date<span class="required">*</span></label>
                    <input asp-for="ValidityDate" type="date"  class="form-control" required />
                    <span asp-validation-for="ValidityDate" class="text-danger"></span>
                </div>
                @if (Model.ProofOfExemptionFilePath == null)
                {
                    <div class="form-group mb-3">
                        <label class="form-label">Upload the proof of exemption documents.</label>
                        <input class="form-control form-control-sm" name="document" type="file">
                        <span asp-validation-for="ProofOfExemptionFilePath" class="text-danger"></span>
                    </div>
                }
                else
                {
                    <a asp-action="DownloadProofOfExemption" asp-route-id="@Model.SupplierId" target="_blank" rel="noopener">Show Document</a>
                    <label class="form-label d-block mt-2">Upload replacement proof of exemption</label>
                    <input class="form-control form-control-sm" name="document" type="file">
                }
            </div>
            @if (Model.ProofOfRegistrationFilePath == null)
            {
                <div class="form-group mb-3">
                    <label class="form-label">Upload the proof of BIR registration</label>
                    <input class="form-control form-control-sm" name="registration" type="file">
                    <span asp-validation-for="ProofOfRegistrationFilePath" class="text-danger"></span>
                </div>
            }
            else
            {
                <a asp-action="DownloadProofOfRegistration" asp-route-id="@Model.SupplierId" target="_blank" rel="noopener">Show Document</a>
                <label class="form-label d-block mt-2">Upload replacement proof of BIR registration</label>
                <input class="form-control form-control-sm" name="registration" type="file">
            }

            <div class="form-check pb-2">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="RequiresPriceAdjustment" /> @Html.DisplayNameFor(model => model.RequiresPriceAdjustment)
                </label>
            </div>

            <div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input"/><label asp-for="IsActive" class="form-check-label"></label></div>
<div class="row pt-2">
                <div class="col-6 col-md-3">
                    <button type="submit" class="btn btn-primary form-control">Save</button>
                </div>
                <div class="col-6 col-md-3">
                    <a  asp-controller="Supplier" asp-action="Index" class="btn btn-outline-primary border  form-control ">Back to List</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/supplier-form.js" asp-append-version="true"></script>

}
